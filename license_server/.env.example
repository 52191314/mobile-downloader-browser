# =============================================================================
# Aurora License Server — example environment
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# --- HTTP ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Number of reverse proxies in front of the app (Caddy/nginx/Cloudflare = 1).
# 0 = direct exposure. Wrong value breaks per-IP rate limiting.
TRUST_PROXY=0

# --- App identity -------------------------------------------------------
# Comma-separated allowlist. Requests for any other package are rejected.
ALLOWED_PACKAGE_NAMES=com.personal.aurora_downloader

# --- Google Play Developer API -----------------------------------------
# Service account with "View financial data" on the app in Play Console.
# Provide EITHER a path to the .json key, OR the raw JSON (single line).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 'google'  = real Android Publisher API (required in production)
# 'fake'    = local stub verifier, refuses to start when NODE_ENV=production
PLAY_VERIFY_MODE=google

# Re-verify a previously stored purchase token at most this often when it is
# only being carried along for the entitlement set (not the token being
# activated). Keeps Google API calls bounded.
VERIFY_CACHE_TTL_MINUTES=360

# --- License signing ----------------------------------------------------
# Directory holding <kid>.key.pem (private) and <kid>.pub.pem (public).
# Generate with: npm run keys:generate
LICENSE_KEY_DIR=./keys
# Which key id signs new licenses. Every key in LICENSE_KEY_DIR is still
# published in JWKS, so rotation has a grace overlap.
LICENSE_ACTIVE_KID=

LICENSE_ISSUER=aurora-license
LICENSE_AUDIENCE=aurora-app

# Offline grace: how long an issued license stays valid without a refresh.
# 30 days until host uptime is proven over a full billing cycle (plan §15).
LICENSE_TTL_DAYS=30

# --- Storage ------------------------------------------------------------
# SQLite file. Contains purchase tokens — restrict file permissions, back up.
DB_PATH=./data/licenses.db

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LICENSE_RATE_LIMIT_MAX=10

# --- Logging ------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
